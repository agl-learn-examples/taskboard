# Optional settings for running TaskBoard on your laptop. To change one, copy this file to .env:
#     cp .env.example .env
# Every value here is a FAKE example for local practice. Never put real passwords or keys in git.
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=example-only-not-a-real-password
POSTGRES_DB=taskboard
# The key that signs login tokens. A real one is long and random, and lives in a secret store.
JWT_SECRET=example-only-not-a-real-jwt-secret-0123456789
GATEWAY_PORT=8080
# Login and sign-up rate limit at the gateway, per client
AUTH_RATE=10r/m
AUTH_BURST=5
# 1: add the demo tenants and users at start-up; 0: start empty
SEED_DEMO=1
# Course A7: start with HTTPS on https://localhost:8443 every time (run gateway/certs/make-dev-cert.sh first)
#COMPOSE_FILE=compose.yaml:compose.https.yaml
