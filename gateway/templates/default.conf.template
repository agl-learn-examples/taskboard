# TaskBoard's API gateway: the one front door. Every request from every app arrives here first.
# Its four jobs: route each request, check the login token, limit how fast one client may call, log it.
#
# The nginx image turns this template into /etc/nginx/conf.d/default.conf at start-up, filling in
# ${AUTH_RATE} and ${AUTH_BURST} from the environment (see compose.yaml).

# ---- log: one JSON line per request, to stdout, so `docker compose logs gateway` shows it
log_format gateway_json escape=json
  '{"time":"$time_iso8601","request_id":"$request_id","client":"$remote_addr",'
  '"method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,'
  '"seconds":$request_time,"upstream":"$upstream_addr","tenant":"$tenant_id","user":"$user_id"}';

# ---- rate limits, counted per client IP address
limit_req_zone $binary_remote_addr zone=per_client:10m rate=10r/s;     # everything
limit_req_zone $binary_remote_addr zone=auth:10m rate=${AUTH_RATE};     # login and sign-up: slows password guessing
limit_req_status 429;

upstream api {
    server api:8000;          # Compose's DNS finds the api service by its name
}

server {
    listen 80;
    server_name _;
    access_log /dev/stdout gateway_json;
    client_max_body_size 1m;

    set $tenant_id "-";
    set $user_id "-";

    # ---- route: /v1/... goes to the API service, without the /v1 (version 1 of the API)
    #      public routes: no token needed
    location = /v1/health          { limit_req zone=per_client burst=20 nodelay; proxy_pass http://api/health; }
    location ~ ^/v1/auth/(login|signup|refresh)$ {
        limit_req zone=auth burst=${AUTH_BURST} nodelay;
        proxy_pass http://api/auth/$1;
    }

    #      everything else under /v1/ needs a valid access token
    location /v1/ {
        auth_request /_auth;                                 # ---- check the token first
        auth_request_set $tenant_id $upstream_http_x_tenant_id;
        auth_request_set $user_id $upstream_http_x_user_id;
        auth_request_set $auth_error $upstream_http_x_auth_error;
        limit_req zone=per_client burst=20 nodelay;
        proxy_pass http://api/;                              # the trailing / drops the /v1 prefix
    }

    # the token check: a small internal request to the API service's /auth/verify
    location = /_auth {
        internal;
        proxy_pass http://api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # everything else is the web app (Course A5): its files are in the image (web/Dockerfile).
    # An address like /tasks/3/edit is not a file: send index.html and the app's router shows the page.
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # headers every proxied request carries to the API service
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Request-ID $request_id always;

    # ---- answers made by the gateway itself, as JSON like the API's
    error_page 401 = @unauthorized;
    error_page 429 = @too_many;
    error_page 502 503 504 = @api_down;
    location @unauthorized { default_type application/json; return 401 '{"error":"$auth_error"}\n'; }
    location @too_many     { default_type application/json; return 429 '{"error":"too many requests, slow down"}\n'; }
    location @api_down     { default_type application/json; return 503 '{"error":"the API service is not answering"}\n'; }
}
